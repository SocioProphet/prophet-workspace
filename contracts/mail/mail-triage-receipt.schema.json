{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.socioprophet.ai/prophet-workspace/mail/mail-triage-receipt.schema.v0.1.json",
  "title": "MailTriageReceipt",
  "description": "Evidence record for any AI or automated triage action on a message or thread. Every routing decision, label suggestion, summary, or reply draft emits a receipt. This is the audit and replay layer — policy-gated actions must have a receipt before taking effect.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "receiptId", "messageRef", "actionType", "status", "issuedAt"],
  "properties": {
    "schemaVersion": { "const": "v0.1" },
    "receiptId": { "type": "string" },
    "messageRef": { "type": "string", "description": "messageId or threadId" },
    "accountRef": { "type": "string" },

    "actionType": {
      "enum": [
        "route_to_slot",
        "apply_label",
        "screener_classify",
        "generate_summary",
        "suggest_reply",
        "snooze",
        "remind",
        "archive",
        "trash",
        "mark_read",
        "create_task",
        "save_to_drive",
        "link_to_workroom"
      ]
    },

    "status": {
      "enum": ["suggested", "applied", "user_confirmed", "user_rejected", "policy_blocked", "failed"]
    },

    "payload": {
      "type": "object",
      "description": "Action-specific data: slot name for route_to_slot, label for apply_label, summary text for generate_summary, etc.",
      "additionalProperties": true
    },

    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "modelRef": { "type": "string" },
    "policyDecisionRef": { "type": "string" },
    "memoryRef": { "type": "string" },

    "issuedAt": { "type": "string", "format": "date-time" },
    "appliedAt": { "type": "string", "format": "date-time" },
    "userDecidedAt": { "type": "string", "format": "date-time" },

    "evidenceRefs": { "type": "array", "items": { "type": "string" }, "default": [] }
  }
}
