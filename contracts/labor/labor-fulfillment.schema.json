{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.socioprophet.dev/prophet-workspace/labor/labor-fulfillment.v0.1.schema.json",
  "title": "Fulfillment v0.1",
  "description": "The work ledger: milestones, proofs, approvals, completion (charter v0.1 §3 Work ledger; LN-005/017). Tracks fulfillment and drives downstream trust events. TEETH: evidence_refs MUST be non-empty — a fulfillment with no evidence is not a fulfillment (LN-005); award_ref MUST point to the awarded LaborResponse; receipt_ref MUST resolve on the receipt spine (AC-1).",
  "type": "object",
  "additionalProperties": false,
  "required": ["record_type", "fulfillment_id", "award_ref", "evidence_refs", "milestones", "completion_status"],
  "properties": {
    "record_type": {"const": "Fulfillment"},
    "fulfillment_id": {"type": "string", "pattern": "^labor-fulfillment:[a-z0-9][a-z0-9:._/@-]{1,160}$"},
    "award_ref": {"type": "string", "pattern": "^labor-response:[a-z0-9][a-z0-9:._/@-]{1,160}$"},
    "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^labor-evidence:[a-z0-9][a-z0-9:._/@-]{1,160}$"}, "description": "LN-005: trial/productive work is evidenced; a fulfillment cites at least one Evidence packet."},
    "milestones": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "proof_ref", "approved"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "proof_ref": {"type": "string", "minLength": 1},
          "approved": {"type": "boolean"}
        }
      }
    },
    "completion_status": {"enum": ["awarded", "in_progress", "delivered", "disputed", "closed"]},
    "receipt_ref": {"$ref": "https://schemas.socioprophet.dev/prophet-workspace/labor/receipt-ref.v0.1.schema.json"}
  }
}
